# --- AI brainstorming (optional) ---------------------------------------------
# Without a key the app still works: it falls back to rule-based name combos.
# Get a key from Vercel AI Gateway (https://vercel.com/docs/ai-gateway).
# On Vercel this is injected automatically via OIDC — only needed for local dev.
AI_GATEWAY_API_KEY=

# Model used for brainstorming (any AI Gateway "provider/model" string).
# Defaults to anthropic/claude-haiku-4-5 if unset.
DOMAIN_AI_MODEL=anthropic/claude-haiku-4-5

# --- Watchlist (optional) -----------------------------------------------------
# Only the watchlist needs these. Search works with none of them set.

# Postgres. Local dev: the README's "Watchlist" section has a one-line Docker
# container. Production: Neon via the Vercel Marketplace, or any Postgres.
DATABASE_URL=

# Shared secret guarding /api/cron/poll. Must match the CRON_SECRET repository
# secret used by .github/workflows/poll.yml. Any long random string:
#   openssl rand -base64 32
CRON_SECRET=

# --- Alert email (optional) ---------------------------------------------------
# With no RESEND_API_KEY, alerts are logged to the console instead of sent, so
# the watchlist is fully drivable locally without signing up for anything.
RESEND_API_KEY=
ALERT_FROM=alerts@example.com

# Public base URL, used to build the manage links inside alert emails.
APP_URL=http://localhost:3000
